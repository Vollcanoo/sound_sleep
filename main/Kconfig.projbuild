menu "Snoring detector"

config SNORE_I2S_BCLK_GPIO
    int "INMP441 BCLK/SCK GPIO"
    default 16

config SNORE_I2S_WS_GPIO
    int "INMP441 WS/LRCLK GPIO"
    default 15

config SNORE_I2S_DOUT_GPIO
    int "INMP441 SD/DOUT GPIO"
    default 17

config SNORE_I2S_USE_RIGHT_CHANNEL
    bool "Read right I2S channel"
    default y

endmenu

menu "Pillow airbag bench test"

config PUMP_BENCH_TEST
    bool "Build airbag bench-test firmware"
    default n
    help
        Build a minimal firmware for verifying the airbag GPIO outputs. It
        starts only the serial command task and pump controller; Wi-Fi, BLE,
        sensors, cloud clients, and sleep-control tasks are excluded.

endmenu
